# Unified OpenAI configuration (works for OpenAI and Azure OpenAI)
# Required
OPENAI_API_KEY=mykey
OPENAI_MODEL=gpt-5

# Optional (required for Azure)
OPENAI_BASE_URL=https://sw-v2-project-resource.openai.azure.com/openai/v1/

# Azure OpenAI API Version (optional for v1 API)
# The modern /openai/v1/ endpoint does NOT require api-version parameter
# It provides automatic access to latest GA features without monthly version updates
# Only uncomment if using legacy Azure OpenAI endpoints (without /openai/v1/)
# OPENAI_API_VERSION=preview

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Logging Configuration
LOG_LEVEL=INFO
REASONING_EFFORT=low

# Memory Features (granular flags)
# Enable raw conversation persistence (ConversationStore)
CONVERSATION_STORE_ENABLED=true
# Enable memory_search tool (semantic search over conversation summaries)
MEMORY_SEARCH_ENABLED=true
# Enable user profile fetching/injection into system prompt
USER_PROFILE_ENABLED=true

# Voice / Realtime API feature
VOICE_ENABLED=false  # Set to true to enable voice mode (requires gpt-4o-realtime-preview model access)

# Code Interpreter Feature
# Enable Python code execution for data analysis and visualization (requires Azure OpenAI Responses API support)
ENABLE_CODE_INTERPRETER=false
CODE_INTERPRETER_CONTAINER_TYPE=auto  # Container type: "auto" (default) or other Azure-supported values

# RAG Feature Configuration
ENABLE_RAG=true
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_RESULTS=3

# Semantic Cache (First-Turn Accelerator)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.8

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=aidb
PGUSER=admin
PGPASSWORD=mypassword

# Embeddings Configuration (for RAG)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Remote MCP Tools (Farmer Tools)
FARMER_TOOLS_ENABLED=true
FARMER_TOOLS_MCP_URL=https://farmer-tools.tomasdemo.org/mcp
# Use the same key as tools/mcp_public_farmer_tools/.env or override as needed
FARMER_TOOLS_MCP_API_KEY=mykey

# Remote MCP Tools (Tavily Search)
# Enable and configure Tavily's remote MCP server for web search capabilities.
# Provides real-time web search, news search, and data extraction tools.
TAVILY_ENABLED=true
TAVILY_API_KEY=mykey

# Remote MCP Tools (Visualization Generator)
# Enable custom HTML visualization generation via reasoning model
# Provides generate_infographic tool for creating interactive UI components
VISUALIZATION_MCP_ENABLED=false
VISUALIZATION_MCP_URL=https://ca-mcp-viz-gen.grayisland-3e7e5fd0.swedencentral.azurecontainerapps.io/mcp
VISUALIZATION_MCP_API_KEY=mykey

# Enable to delegate chef search, catering, availability, pricing, and booking queries to specialized agent
CHEF_AGENT_ENABLED=false
CHEF_AGENT_URL=http://localhost:8002

# Local Stock Tool
# Enable to allow the agent to fetch stock levels by product UUIDs from api_stock service.
STOCK_TOOL_ENABLED=true
# Base URL of the stock API (default when running via docker-compose)
STOCK_API_URL=http://localhost:8011

# Authentication (Keycloak)
# Agentic Search (tool-based retrieval) configuration
AGENTIC_SEARCH_ENABLED=true
AGENTIC_SEARCH_MAX_RESULTS=10
# Toggle JWT auth (true/false). When true endpoints validate RS256 token against realm JWKS.
AUTH_ENABLED=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dreamfarm
# Expected audience (client ID) inside access tokens
KEYCLOAK_AUDIENCE=account

# Graph Search (Apache AGE traversal tools)
# Enable DFS similarity tool (and future BFS). Requires AGE graph imported.
GRAPH_SEARCH_ENABLED=true
# Name of the AGE graph created by import scripts
AGE_GRAPH_NAME=dreamfarm
# Safety cap for DFS results (k is additionally bounded 3..10 at runtime)
GRAPH_DFS_MAX_RESULTS=10

# Test API (for PyRIT / Security Testing)
# Enable /test/chat endpoint for automated red teaming and security testing
# WARNING: Disable in production! This endpoint bypasses normal authentication.
TEST_API_ENABLED=false
# API key required to access /test/chat endpoint (leave empty to disable key requirement)
TEST_API_KEY=your_test_api_key_here