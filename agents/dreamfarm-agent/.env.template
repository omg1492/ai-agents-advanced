# Unified OpenAI configuration (works for OpenAI and Azure OpenAI)
# Required
OPENAI_API_KEY=mykey
OPENAI_MODEL=gpt-5

# Optional (required for Azure)
OPENAI_BASE_URL=https://sw-v2-project-resource.openai.azure.com/openai/v1/
OPENAI_API_VERSION=preview

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Logging Configuration
LOG_LEVEL=INFO
REASONING_EFFORT=low

# RAG Feature Configuration
ENABLE_RAG=true
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_RESULTS=3

# Semantic Cache (First-Turn Accelerator)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.8

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=aidb
PGUSER=admin
PGPASSWORD=mypassword

# Embeddings Configuration (for RAG)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Remote MCP Tools (Farmer Tools)
FARMER_TOOLS_ENABLED=true
FARMER_TOOLS_MCP_URL=https://farmer-tools.tomasdemo.org/mcp
# Use the same key as tools/mcp_public_farmer_tools/.env or override as needed
FARMER_TOOLS_MCP_API_KEY=mykey

# Remote MCP Tools (Tavily Search)
# Enable and configure Tavily's remote MCP server for web search capabilities.
# Provides real-time web search, news search, and data extraction tools.
TAVILY_ENABLED=true
TAVILY_API_KEY=mykey

# Local Stock Tool
# Enable to allow the agent to fetch stock levels by product UUIDs from api_stock service.
STOCK_TOOL_ENABLED=true
# Base URL of the stock API (default when running via docker-compose)
STOCK_API_URL=http://localhost:8011

# Authentication (Keycloak)
# Agentic Search (tool-based retrieval) configuration
AGENTIC_SEARCH_ENABLED=true
AGENTIC_SEARCH_MAX_RESULTS=10
# Toggle JWT auth (true/false). When true endpoints validate RS256 token against realm JWKS.
AUTH_ENABLED=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dreamfarm
# Expected audience (client ID) inside access tokens
KEYCLOAK_AUDIENCE=account