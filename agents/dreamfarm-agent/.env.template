# OpenAI Provider Configuration
# Set to 'azure' for Azure OpenAI Service or 'openai' for OpenAI API
OPENAI_API_TYPE=azure

# Azure OpenAI Configuration (when OPENAI_API_TYPE=azure)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1

# OpenAI Configuration (when OPENAI_API_TYPE=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Logging Configuration
LOG_LEVEL=INFO

# RAG Feature Configuration
ENABLE_RAG=true
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_RESULTS=3

# PostgreSQL Database Configuration (using standard PG environment variables)
PGHOST=localhost
PGPORT=5432
PGDATABASE=aidb
PGUSER=admin
PGPASSWORD=your-password

# Azure OpenAI Embeddings Configuration (for RAG)
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_API_KEY=your-api-key-here
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# OpenAI Embeddings Configuration (when OPENAI_API_TYPE=openai)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large