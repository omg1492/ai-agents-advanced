# Unified OpenAI configuration (works for OpenAI and Azure OpenAI)
#
# OpenAI (hosted by OpenAI):
#   - Set only OPENAI_API_KEY and OPENAI_MODEL.
# Azure OpenAI (next-gen v1):
#   - Set OPENAI_API_KEY to your Azure key,
#   - Set OPENAI_BASE_URL to https://<resource>.openai.azure.com/openai/v1/
#   - Set OPENAI_API_VERSION to preview (or latest when GA).

# Required
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5  # For Azure, this is the Deployment name

# Optional (required for Azure)
OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
OPENAI_API_VERSION=preview

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Logging Configuration
LOG_LEVEL=INFO

# RAG Feature Configuration
ENABLE_RAG=true
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_RESULTS=3

# Semantic Cache (First-Turn Accelerator)
# High similarity threshold (>=0.8 recommended) to avoid mismatches.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.8
# Optional custom embedding model; defaults to OPENAI_EMBEDDING_MODEL when unset
# SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-3-large

# PostgreSQL Database Configuration (using standard PG environment variables)
PGHOST=localhost
PGPORT=5432
PGDATABASE=aidb
PGUSER=admin
PGPASSWORD=your-password

# Embeddings Configuration (for RAG)
# Use the same unified scheme: for Azure, OPENAI_BASE_URL + OPENAI_API_VERSION applies.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large  # For Azure, this is the Deployment name

# Remote MCP Tools (Farmer Tools)
# Enable and configure a remote MCP server exposed over HTTP. The DreamFarm Agent
# will pass this as a tool to the OpenAI Responses API with a Bearer token header.
# Default URL points to the public demo server; update for your environment.
FARMER_TOOLS_ENABLED=true
FARMER_TOOLS_MCP_URL=https://farmer-tools.tomasdemo.org/mcp
# Prefer namespaced key; MCP_API_KEY is accepted as fallback for convenience.
FARMER_TOOLS_MCP_API_KEY=your-farmer-tools-api-key

# Remote MCP Tools (Tavily Search)
# Enable and configure Tavily's remote MCP server for web search capabilities.
# Provides real-time web search, news search, and data extraction tools.
TAVILY_ENABLED=true
TAVILY_API_KEY=your-tavily-api-key

# Local Stock Tool
# Enable to allow the agent to fetch stock levels by product UUIDs from api_stock service.
STOCK_TOOL_ENABLED=true
# Base URL of the stock API (default when running via docker-compose)
STOCK_API_URL=http://localhost:8011
