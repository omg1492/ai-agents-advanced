# PyRIT Red Teaming Configuration
# 
# NOTE: This file is for REFERENCE ONLY.
# The red teaming script automatically loads the agent's .env file
# from agents/dreamfarm-agent/.env (two directories up).
#
# You should configure these variables in the AGENT's .env file.

# ============================================================================
# Azure OpenAI Configuration (Required for LLM-as-judge scoring)
# ============================================================================

# Your Azure OpenAI API key
OPENAI_API_KEY=<your-azure-openai-key>

# Azure OpenAI endpoint (must include /openai/v1/ suffix)
OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/

# API version (should be "preview" for latest features)
OPENAI_API_VERSION=preview

# Model name for scoring (should match your deployment)
OPENAI_MODEL=gpt-5

# ============================================================================
# Agent Target Configuration
# ============================================================================

# URL of the DreamFarm agent to test
# Default: http://localhost:8001 (when running locally)
DREAMFARM_AGENT_URL=http://localhost:8001

# ============================================================================
# Authentication (Optional)
# ============================================================================

# If your agent requires authentication, you can set a bearer token here
# The HTTPTarget will include this in the Authorization header
# DREAMFARM_AGENT_AUTH_TOKEN=<your-token>

# ============================================================================
# Usage Instructions
# ============================================================================
#
# 1. Configure the agent's .env file (agents/dreamfarm-agent/.env)
#    with your Azure OpenAI credentials
#
# 2. Start the agent:
#    cd agents/dreamfarm-agent/src
#    uv run python main.py
#
# 3. Verify setup:
#    cd agents/dreamfarm-agent/tests/redteaming
#    uv run python verify_setup.py
#
# 4. Run red teaming:
#    uv run python run_redteaming.py
#
# ============================================================================
# Advanced Configuration
# ============================================================================

# Maximum prompts to test per dataset (default: 10)
# You can override this by editing run_redteaming.py attack_configs
# MAX_PROMPTS_PER_DATASET=20

# Enable verbose logging for debugging
# LOG_LEVEL=DEBUG

# ============================================================================
# Environment Variable Precedence
# ============================================================================
#
# The red teaming scripts look for environment variables in this order:
# 1. Environment variables set in the shell
# 2. Variables from agents/dreamfarm-agent/.env (loaded by dotenv)
# 3. Default values in the script
#
# This means you can override any setting by setting it in your shell:
#   $env:DREAMFARM_AGENT_URL = "https://production.example.com"
#   uv run python run_redteaming.py
