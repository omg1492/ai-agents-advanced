# Unified OpenAI configuration (works for OpenAI and Azure OpenAI)
# Required
OPENAI_API_KEY=mykey
OPENAI_MODEL=gpt-5

# Optional (required for Azure)
OPENAI_BASE_URL=https://sw-v2-project-resource.openai.azure.com/openai/v1/
OPENAI_API_VERSION=preview

# Optional reasoning effort (for GPT-5 models)
REASONING_EFFORT=low

# CORS Configuration
CORS_ORIGINS=*

# Logging Configuration
LOG_LEVEL=INFO

# Server Configuration
PORT=8002

# OpenTelemetry Configuration (distributed tracing)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable tracing (leave empty to disable)
OTEL_SERVICE_NAME=chef-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPERIMENT=production
# OpenAI Instrumentation Provider: "opentelemetry" (standard GenAI conventions) or "openinference" (Responses API streaming support)
OTEL_INSTRUMENTATION_PROVIDER=openinference

# Chef Services MCP Configuration
CHEF_SERVICES_MCP_URL=https://ca-mcp-chef-services.grayisland-3e7e5fd0.swedencentral.azurecontainerapps.io/mcp
CHEF_SERVICES_MCP_API_KEY=advancedaiapps2025
