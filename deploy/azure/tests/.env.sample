# Service IP Addresses (LoadBalancer external IPs)
# Get these from: kubectl get svc -o wide
# Note: These are automatically assigned by Azure after deployment

MCP_VISUALIZATION_IP=your-loadbalancer-ip-here
MCP_PUBLIC_FARMER_IP=your-loadbalancer-ip-here
MCP_CHEF_SERVICES_IP=your-loadbalancer-ip-here
API_STOCK_IP=your-clusterip-here

# MCP API Key for authentication
# This key is required to access MCP services
# Note: This is automatically generated by Terraform during deployment
MCP_API_KEY=your-mcp-api-key-here
