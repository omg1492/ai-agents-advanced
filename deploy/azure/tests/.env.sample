# Service IPs for deployed services
# This file is AUTOMATICALLY GENERATED by Terraform
# Location: deploy/azure/infrastructure/helm.tf (local_file.test_env)
#
# After running 'terraform apply', the .env file will be created with:
# - Static LoadBalancer IPs (known before deployment)
# - MCP API key (generated by Terraform)
#
# DO NOT EDIT .env MANUALLY - It will be overwritten by Terraform

# MCP API Key for authentication
MCP_API_KEY=your-mcp-api-key-here

# Service IPs (LoadBalancer external IPs - Static)
MCP_VISUALIZATION_IP=your-loadbalancer-ip-here
MCP_PUBLIC_FARMER_IP=your-loadbalancer-ip-here
MCP_CHEF_SERVICES_IP=your-loadbalancer-ip-here

# API Services (ClusterIP - for internal access only)
API_STOCK_IP=your-clusterip-here
