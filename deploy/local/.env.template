# PostgreSQL Configuration (standard PG environment variables)
PGDATABASE=aidb
PGUSER=admin
PGPASSWORD=your_secure_password_here
PGHOST=localhost
PGPORT=5432

# OpenAI Provider Configuration
# Set to 'azure' for Azure OpenAI Service or 'openai' for OpenAI API
OPENAI_API_TYPE=azure

# Azure OpenAI Configuration (when OPENAI_API_TYPE=azure)
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# OpenAI Configuration (when OPENAI_API_TYPE=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:80
