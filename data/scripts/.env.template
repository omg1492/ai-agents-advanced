# Unified OpenAI configuration (works for OpenAI and Azure OpenAI)
# Required
OPENAI_API_KEY=sk-your-openai-or-azure-key
OPENAI_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Optional (required for Azure)
OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
OPENAI_API_VERSION=preview

# PostgreSQL Database Configuration (standard PG environment variables)
PGHOST=localhost
PGPORT=5432
PGDATABASE=aidb
PGUSER=admin
PGPASSWORD=my-secure-password-here

# Data processing
PDF_INPUT_DIR=../PDFs
IMAGES_INPUT_DIR=../images
VIDEOS_INPUT_DIR=../videos

# Local Whisper transcription (replaces remote GPT transcription)
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# WHISPER_LANGUAGE=  # leave empty for auto-detect

# Taxonomy enrichment (gen_graph_taxonomy.py)
# Batch size of products per assignment LLM call (higher = fewer, larger calls)
TAXONOMY_BATCH_SIZE=40
# State file path (relative to this directory or absolute)
TAXONOMY_STATE_PATH=../processed/taxonomy_state.json
# Force regeneration of concepts on next run (alternative to --rebuild-concepts CLI flag)
TAXONOMY_FORCE_REGENERATE_CONCEPTS=false