# Local development defaults
# Copy this file to .env and set your secrets

# HTTP binding
HOST=0.0.0.0
PORT=8013

# Comma-separated list or * for wildcard
MCP_CORS_ORIGINS=*

# API key used as Bearer token for auth (required)
# Example: MCP_API_KEY=dev-chef-secret
MCP_API_KEY=

# Workaround for clients that close sessions too early. Non-zero intercepts
# DELETE /mcp and performs it internally after the delay. Default 60s.
MCP_DEFER_DELETE_SECONDS=60

# OpenTelemetry Configuration (traces, logs, and metrics)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable observability (leave empty to disable)
# The collector will route traces to Tempo, logs to Loki, and metrics to Prometheus
OTEL_SERVICE_NAME=mcp-chef-services
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPERIMENT=production

# Remote MCP server configuration (for integration tests)
# Set these to test against the deployed Azure Container Apps instance
CHEF_SERVICES_MCP_URL=https://ca-mcp-chef-services.grayisland-3e7e5fd0.swedencentral.azurecontainerapps.io/mcp
CHEF_SERVICES_MCP_API_KEY=advancedaiapps2025
