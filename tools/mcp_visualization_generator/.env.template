# Environment variables for MCP Visualization Generator server

# Server configuration
HOST=0.0.0.0
PORT=5003
MCP_CORS_ORIGINS=*

# Authentication (required)
MCP_API_KEY=your-secret-key-here

# OpenAI configuration (required)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5
REASONING_EFFORT=low

# Azure OpenAI specific (optional, only needed for Azure)
OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
OPENAI_API_VERSION=preview

# OpenTelemetry Configuration (distributed tracing)
# Set OTEL_EXPORTER_OTLP_ENDPOINT to enable tracing (leave empty to disable)
OTEL_SERVICE_NAME=mcp-visualization-generator
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPERIMENT=production
# OpenAI Instrumentation Provider: "opentelemetry" (standard GenAI conventions) or "openinference" (Responses API streaming support)
OTEL_INSTRUMENTATION_PROVIDER=openinference
